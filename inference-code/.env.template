# OpenAI-compatible API config. Leave OPENAI_BASE_URL blank to use OpenAI
# directly, or point it at any OpenAI-compatible vision-capable provider
# (e.g. QwenCloud's DashScope endpoint, or GPT-5.6-Luna) with a matching
# OPENAI_VLM_MODEL_NAME. Fill in OPENAI_BASE_URL with the provider's
# OpenAI-compatible endpoint - models/openai_vlm.py sends images as
# chat.completions image_url content blocks, so the provider must support
# vision input, not just text.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VLM_MODEL_NAME=gpt-5.6-luna
# Live-safe upper bounds. Lower the token budget for faster, simpler queries;
# raise it only when the selected reasoning model needs more room.
OPENAI_VLM_MAX_COMPLETION_TOKENS=4096
OPENAI_VLM_TIMEOUT_SEC=45
# Optional regex removed from every VLM reply, for gateways that append text
# (e.g. a router attribution footer) that would otherwise break JSON parsing
# and pollute HyDE embeddings. Leave blank to keep replies untouched.
OPENAI_VLM_STRIP_REGEX=
# Retries (with Retry-After backoff) for the OpenAI client; raise it for gateways
# with a low rate limit, together with a lower VQA_MAX_WORKERS.
OPENAI_VLM_MAX_RETRIES=2

# Model selection options
VLM_OPTION=openai
# Applied only to VLM clients that support concurrent requests.
VQA_MAX_WORKERS=8
# Primary visual/text embeddings always use Tencent WeMM Embedding 4B.
# The model revision is pinned by default; override only for a reviewed
# deployment checkpoint. Leave the MRL dimension blank for the native 2560.
WEMM_MODEL_REVISION=41a4fafdd26252ddff05c025413af7e61e26f08e
EMBEDDING_MRL_DIM=
# Allowed WeMM dimensions: 64, 128, 256, 512, 1024, 2560.
# A separate collection prevents mixing this embedding space with old indexes.
VISUAL_COLLECTION_NAME=visual_keyframes_v1
SHOT_COLLECTION_NAME=vbs_shot_index
# Uniform nested-RRF weights; change only as part of a recorded configuration.
RRF_DENSE_WEIGHT=1.0
RRF_LEXICAL_WEIGHT=1.0
RRF_QUERY_WEIGHT=1.0
RRF_HYDE_WEIGHT=1.0
RRF_SECONDARY_WEIGHT=1.0
# "false" skips the Type-1 VLM rerank and its score threshold (ablation only).
TYPE1_VLM_RERANK_ENABLED=true

# VLM checkpoint (independent from the primary embedder)
QWEN_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
M2D_CLAP_MODEL_ID=weights/m2d_clap_vit_base-80x1001p16x16p16kpBpTI-2025/checkpoint-30.pth

# Object detector checkpoint (YOLOE-26, open-vocabulary text-prompt detection)
# Set to none to use full frames without loading a detector.
DETECTOR_OPTION=local
YOLOE_MODEL_ID=yoloe-26x-seg.pt
DETECTION_CONF_THRESHOLD=0.15

# Qdrant configs
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# H-EAGLE-lite shot coarse-to-fine routing. Keep off until benchmarked.
HEAGLE_LITE_ENABLED=false
HEAGLE_SHOT_TOP_K=64
HEAGLE_FRAME_MULTIPLIER=4




VLM_MIN_PIXELS=200704
VLM_MAX_PIXELS=602112
